# SpaceHunter backend configuration — copy to backend/.env and fill in.
# backend/.env is gitignored; never commit real values.

# Database. The demo runs on SQLite in WAL mode at the repo root;
# any SQLAlchemy URL works (the original Postgres URL is shown commented).
DATABASE_URL=sqlite+aiosqlite:///./demo.db
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/spacehunter

# Session/signing secret for the app (set a long random value in production).
SECRET_KEY=change-me

# Telegram bot token (same bot that serves the Mini App entry point).
# NOTE: demo_serve/bot_runner read the token from .bot-token at the repo
# root; this variable is used by the backend's Telegram helpers.
TELEGRAM_BOT_TOKEN=

# TON API endpoint (wallet/jetton lookups); leave default unless self-hosting.
TON_API_ENDPOINT=https://toncenter.com/api/v2

# Authentication gate: "on" requires every request to carry Telegram
# initData signed with the bot token (HMAC-SHA256, WebAppData scheme) and
# binds path/body identity claims to the signer. Keep "on" in production.
SPACEHUNTER_AUTH=on

# Comma-separated Telegram user IDs allowed into the admin panel.
SPACEHUNTER_ADMIN_IDS=
